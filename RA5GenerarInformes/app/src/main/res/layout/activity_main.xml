<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Informe de ofertas"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/textoCiudad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona una ciudad"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/spinnerCiudad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/salarioMinimo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Salario mínimo (€)"
        android:inputType="number"
        android:text="0" />

    <Button
        android:id="@+id/botonGenerarInforme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Generar informe" />

    <Button
        android:id="@+id/botonExportarPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exportar PDF" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#CCCCCC" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenedorInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoCiudadSeleccionada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ciudad seleccionada: -"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textoNumeroOfertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Número de ofertas: -"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textoSalarioTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Salario total: -"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textoSalarioMedio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Salario medio: -"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textoSalarioMaximo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Salario máximo: -"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textoSalarioMinimo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Salario mínimo: -"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/mejorOferta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="10dp"
                android:background="#EEEEEE"
                android:text="La oferta mejor pagada del filtro es: -"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoTituloGrafico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Ofertas por ciudad"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="85dp"
                        android:layout_height="wrap_content"
                        android:text="Valencia" />

                    <ProgressBar
                        android:id="@+id/barraValencia"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:layout_weight="1"
                        android:indeterminate="false"
                        android:max="1"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/textoCantidadValencia"
                        android:layout_width="35dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="85dp"
                        android:layout_height="wrap_content"
                        android:text="Madrid" />

                    <ProgressBar
                        android:id="@+id/barraMadrid"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:layout_weight="1"
                        android:indeterminate="false"
                        android:max="1"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/textoCantidadMadrid"
                        android:layout_width="35dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="85dp"
                        android:layout_height="wrap_content"
                        android:text="Alicante" />

                    <ProgressBar
                        android:id="@+id/barraAlicante"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:layout_weight="1"
                        android:indeterminate="false"
                        android:max="1"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/textoCantidadAlicante"
                        android:layout_width="35dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="85dp"
                        android:layout_height="wrap_content"
                        android:text="Segorbe" />

                    <ProgressBar
                        android:id="@+id/barraSegorbe"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:layout_weight="1"
                        android:indeterminate="false"
                        android:max="1"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/textoCantidadSegorbe"
                        android:layout_width="35dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/textoTituloListado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Listado de ofertas"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorOfertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>